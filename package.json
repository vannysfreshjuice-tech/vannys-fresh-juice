{
  "name": "vannys-fresh-juice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vanny's Fresh Juice: buying fruit, making juice, the fridge, sales, orders, deliveries, reminders, staff and profit. Works on a phone (home screen app) and on a laptop.",
  "scripts": {
    "dev": "vite --port 5191 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5192 --strictPort",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-vannys",
    "dev:emulator": "vite --mode emulator --port 5193 --strictPort",
    "test:rules": "firebase emulators:exec --only firestore,auth --project demo-vannys \"node scripts/test-rules.mjs\""
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
